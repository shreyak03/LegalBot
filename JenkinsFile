
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out LegalBot source code'
                checkout scm
            }
        }

        stage('Install Test Dependencies') {
            steps {
                bat 'py -3.11 -m pip install -r requirements.txt'
                bat 'py -3.11 -m pip install pytest'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'py -3.11 -m pytest -v'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t legalbot:latest .'
            }
        }

        stage('Deploy Container') {
            steps {
                bat 'docker rm -f legalbot-container 2>NUL || exit /b 0'
                bat 'docker run -d --name legalbot-container --env-file "D:\\Btech\\GenAI\\LegalBot\\.env" -p 8000:8000 legalbot:latest'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'powershell -NoProfile -Command "$r = Invoke-WebRequest -Uri http://localhost:8000/health -TimeoutSec 30; if ($r.StatusCode -ne 200) { exit 1 }; Write-Output $r.Content"'
            }
        }
    }

    post {
        success {
            echo 'LegalBot pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the failed stage logs.'
        }
    }
}
