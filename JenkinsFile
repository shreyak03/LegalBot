
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'legalbot:latest'
        CONTAINER_NAME = 'legalbot-container'
        HOST_PORT = '8000'
        CONTAINER_PORT = '8000'
        PYTHON_EXE = 'D:\\Btech\\GenAI\\LegalBot\\.venv\\Scripts\\python.exe'
        ENV_FILE = 'D:\\Btech\\GenAI\\LegalBot\\.env'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out LegalBot source code'
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                bat '''
                    if not exist "%PYTHON_EXE%" (
                        echo ERROR: Python executable not found.
                        exit /b 1
                    )
                    "%PYTHON_EXE%" --version
                    docker --version
                    if errorlevel 1 exit /b 1

                    if not exist requirements.txt exit /b 1
                    if not exist Dockerfile exit /b 1
                '''
            }
        }

        stage('Install Test Dependencies') {
            steps {
                bat '''
                    "%PYTHON_EXE%" -m pip install -r requirements.txt
                    if errorlevel 1 exit /b 1
                    "%PYTHON_EXE%" -m pip install pytest
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Run Tests') {
            steps {
                bat '''
                    "%PYTHON_EXE%" -m pytest -v
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    docker build -t %IMAGE_NAME% .
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Deploy Container') {
            steps {
                bat '''
                    if not exist "%ENV_FILE%" (
                        echo ERROR: Environment file not found.
                        exit /b 1
                    )

                    docker rm -f %CONTAINER_NAME% 2>NUL
                    docker run -d --name %CONTAINER_NAME% --restart unless-stopped --env-file "%ENV_FILE%" -p %HOST_PORT%:%CONTAINER_PORT% %IMAGE_NAME%
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '''
                    powershell -NoProfile -ExecutionPolicy Bypass -Command "$ok = $false; for ($i = 0; $i -lt 12; $i++) { try { $r = Invoke-WebRequest -Uri 'http://localhost:8000/health' -UseBasicParsing -TimeoutSec 5; if ($r.StatusCode -eq 200) { $r.Content; $ok = $true; break } } catch { Start-Sleep -Seconds 5 } }; if (-not $ok) { docker logs legalbot-container; exit 1 }"
                    if errorlevel 1 exit /b 1
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Tests passed and LegalBot deployment was verified.'
            bat 'docker ps --filter "name=legalbot-container"'
        }

        failure {
            echo 'FAILURE: Check the failed stage in Console Output.'
            bat 'docker ps -a --filter "name=legalbot-container"'
        }

        always {
            echo 'LegalBot CI/CD pipeline execution completed.'
        }
    }
}
